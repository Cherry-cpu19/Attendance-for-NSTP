# Copy to .env and set unique values before using beyond a local demo.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
# Initial administrator account; additional admins can be created from the admin dashboard.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
# Set true to require a six-digit email code after every administrator password login.
ADMIN_EMAIL_MFA=false
# SMTP settings used for password-reset emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NSTP Attendance <no-reply@example.com>"
APP_BASE_URL=http://localhost:3000
